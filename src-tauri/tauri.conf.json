{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fingerprint Collector",
  "version": "1.0.0",
  "identifier": "com.geffert.fingerprintcollector",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Network Fingerprint Collector",
        "width": 900,
        "height": 720,
        "minWidth": 420,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Peter Geffert",
    "copyright": "© Copyright Peter Geffert 2026",
    "category": "Utility",
    "shortDescription": "Collect system and network fingerprints",
    "longDescription": "Gathers system and network details (OS, host name, processor, IP and MAC address) and logs each fingerprint to a CSV file.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
