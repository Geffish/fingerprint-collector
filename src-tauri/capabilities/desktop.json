{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Desktop-only features: start at sign-in and automatic updates",
  "platforms": [
    "windows",
    "linux",
    "macOS"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "updater:default",
    "process:allow-restart"
  ]
}
